DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_SECRET=
NEXTAUTH_URL=
# Required in production for encrypted environment variables.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Optional: live deployment tracking (deployments page shows demo data without these)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Optional: the team (team_…) that owns the project. Auto-detected when the token can see it.
# VERCEL_TEAM_ID=
RAILWAY_TOKEN=
RAILWAY_PROJECT_ID=
# Optional: track one service / environment when the Railway project has several.
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=

# Meetings (Google Calendar + Meet). Create an OAuth "Web application" client in Google Cloud,
# enable the Google Calendar API, and add ${NEXTAUTH_URL}/api/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: override the redirect URI when it can't be derived from NEXTAUTH_URL.
# GOOGLE_REDIRECT_URI=
# Image attachments (paste screenshots into test cases, bugs, work items, comments).
# Cloudinary dashboard → Settings → API Keys. Uploads go straight from the browser; the secret stays on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
