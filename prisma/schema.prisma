generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String         @id @default(cuid())
  username               String         @unique
  passwordHash           String
  displayName            String
  role                   Role           @default(MEMBER)
  department             Department     @default(GENERAL)
  avatarColor            String         @default("#5B5FEF")
  isActive               Boolean        @default(true)
  mustChangePassword     Boolean        @default(true)
  createdAt              DateTime       @default(now())
  lastSeenAt             DateTime?
  activityLogs           ActivityLog[]
  comments               Comment[]
  createdEnvironments    Environment[]  @relation("EnvironmentCreator")
  paidExpenses           Expense[]      @relation("ExpensePayer")
  expenseSplits          ExpenseSplit[] @relation("UserExpenseSplit")
  createdNotebooks       Notebook[]     @relation("NotebookCreator")
  ticketsAssigned        Ticket[]       @relation("AssignedTo")
  ticketsCreated         Ticket[]       @relation("CreatedBy")
  accessibleBoards       Board[]        @relation("BoardAccess")
  accessibleEnvironments Environment[]  @relation("EnvironmentAccess")
  writableEnvironments   Environment[]  @relation("EnvironmentWriteAccess")

  @@index([department])
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  githubRepo   String?
  boards       Board[]
  environments Environment[]
  notebooks    Notebook[]
}

model Board {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  department  Department
  description String?
  projectId   String
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns     Column[]
  tickets     Ticket[]
  members     User[]     @relation("BoardAccess")

  @@index([projectId])
}

model Column {
  id       String   @id @default(cuid())
  boardId  String
  name     String
  order    Int
  wipLimit Int?
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@index([boardId])
}

model Ticket {
  id             String        @id @default(cuid())
  boardId        String
  columnId       String
  title          String
  description    String?
  priority       Priority      @default(MEDIUM)
  department     Department
  order          Int
  assigneeId     String?
  createdById    String
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastActivityAt DateTime      @default(now())
  activityLogs   ActivityLog[]
  comments       Comment[]
  assignee       User?         @relation("AssignedTo", fields: [assigneeId], references: [id])
  board          Board         @relation(fields: [boardId], references: [id])
  column         Column        @relation(fields: [columnId], references: [id])
  createdBy      User          @relation("CreatedBy", fields: [createdById], references: [id])
  labels         Label[]       @relation("TicketLabels")

  @@index([boardId, columnId])
  @@index([assigneeId])
}

model Label {
  id      String   @id @default(cuid())
  name    String   @unique
  color   String
  tickets Ticket[] @relation("TicketLabels")
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model ActivityLog {
  id        String         @id @default(cuid())
  ticketId  String
  userId    String
  action    ActivityAction
  fromValue String?
  toValue   String?
  createdAt DateTime       @default(now())
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId, createdAt])
}

model Environment {
  id           String                @id @default(cuid())
  name         String
  projectId    String
  createdById  String
  createdAt    DateTime              @default(now())
  createdBy    User                  @relation("EnvironmentCreator", fields: [createdById], references: [id])
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variables    EnvironmentVariable[]
  allowedUsers User[]                @relation("EnvironmentAccess")
  writeUsers   User[]                @relation("EnvironmentWriteAccess")

  @@index([projectId])
}

model EnvironmentVariable {
  id            String      @id @default(cuid())
  key           String
  value         String
  environmentId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([environmentId])
}

model Expense {
  id        String         @id @default(cuid())
  name      String
  amount    Float
  date      DateTime
  payerId   String
  createdAt DateTime       @default(now())
  payer     User           @relation("ExpensePayer", fields: [payerId], references: [id])
  splits    ExpenseSplit[]

  @@index([payerId])
}

model ExpenseSplit {
  id         String  @id @default(cuid())
  expenseId  String
  userId     String
  amountOwed Float
  isPaid     Boolean @default(false)
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User    @relation("UserExpenseSplit", fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}

model Notebook {
  id          String   @id @default(cuid())
  title       String
  projectId   String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  content     String?
  createdBy   User     @relation("NotebookCreator", fields: [createdById], references: [id])
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model realtime_doc_store {
  id  String @id
  doc String
}

enum Role {
  ADMIN
  MEMBER
  MANAGER
}

enum Department {
  DEV
  DESIGN
  MARKETING
  GENERAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityAction {
  CREATED
  MOVED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  EDITED
  COMPLETED
  REOPENED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  LABEL_ADDED
  LABEL_REMOVED
}
