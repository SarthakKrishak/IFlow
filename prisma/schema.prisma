generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String         @id @default(cuid())
  username               String         @unique
  passwordHash           String
  displayName            String
  role                   Role           @default(MEMBER)
  department             Department     @default(GENERAL)
  avatarColor            String         @default("#5B5FEF")
  isActive               Boolean        @default(true)
  mustChangePassword     Boolean        @default(true)
  createdAt              DateTime       @default(now())
  lastSeenAt             DateTime?
  activityLogs           ActivityLog[]
  comments               Comment[]
  createdEnvironments    Environment[]  @relation("EnvironmentCreator")
  paidExpenses           Expense[]      @relation("ExpensePayer")
  expenseSplits          ExpenseSplit[] @relation("UserExpenseSplit")
  createdNotebooks       Notebook[]     @relation("NotebookCreator")
  ticketsAssigned        Ticket[]       @relation("AssignedTo")
  ticketsCreated         Ticket[]       @relation("CreatedBy")
  accessibleBoards       Board[]        @relation("BoardAccess")
  accessibleEnvironments Environment[]  @relation("EnvironmentAccess")
  writableEnvironments   Environment[]  @relation("EnvironmentWriteAccess")
  ticketAssignments      TicketAssignee[]
  notifications          Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  ownedTrackerPages      TrackerPage[]        @relation("PageOwner")
  createdTrackerPages    TrackerPage[]        @relation("PageCreator")
  assignedWorkItems      WorkItem[]           @relation("WorkItemAssignee")
  reviewingWorkItems     WorkItem[]           @relation("WorkItemReviewer")
  createdWorkItems       WorkItem[]           @relation("WorkItemCreator")
  workItemSubmissions    WorkItemSubmission[] @relation("SubmissionAuthor")
  workItemReviews        WorkItemReview[]     @relation("ReviewAuthor")
  workItemComments       WorkItemComment[]    @relation("WorkItemCommentAuthor")
  assignedBugs           TrackerBug[]         @relation("BugAssignee")
  reportedBugs           TrackerBug[]         @relation("BugReporter")
  trackerAudits          TrackerAudit[]       @relation("TrackerAuditActor")
  googleConnections      GoogleConnection[]   @relation("GoogleConnector")
  memberEmail            MemberEmail?         @relation("MemberEmailUser")
  createdMeetings        Meeting[]            @relation("MeetingCreator")
  meetingAttendances     MeetingAttendee[]    @relation("MeetingAttendeeUser")

  @@index([department])
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String?
  createdAt    DateTime      @default(now())
  githubRepo   String?
  boards       Board[]
  environments Environment[]
  notebooks    Notebook[]
  trackerPages TrackerPage[]
  meetings     Meeting[]
}

model Board {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  department  Department
  description String?
  projectId   String
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns     Column[]
  tickets     Ticket[]
  members     User[]     @relation("BoardAccess")

  @@index([projectId])
}

model Column {
  id       String   @id @default(cuid())
  boardId  String
  name     String
  order    Int
  wipLimit Int?
  board    Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tickets  Ticket[]

  @@index([boardId])
}

model Ticket {
  id             String        @id @default(cuid())
  boardId        String
  columnId       String
  title          String
  description    String?
  priority       Priority      @default(MEDIUM)
  department     Department
  order          Int
  assigneeId     String?
  createdById    String
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastActivityAt DateTime      @default(now())
  activityLogs   ActivityLog[]
  comments       Comment[]
  assignee       User?         @relation("AssignedTo", fields: [assigneeId], references: [id])
  board          Board         @relation(fields: [boardId], references: [id])
  column         Column        @relation(fields: [columnId], references: [id])
  createdBy      User          @relation("CreatedBy", fields: [createdById], references: [id])
  labels         Label[]       @relation("TicketLabels")
  extraAssignees TicketAssignee[]
  notifications  Notification[]
  workItem       WorkItem?

  @@index([boardId, columnId])
  @@index([assigneeId])
}

// Additive join table for multi-assign. Legacy `Ticket.assigneeId` is kept as
// the primary assignee so all existing queries keep working unchanged.
model TicketAssignee {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
}

// Additive notification store for @mentions (and future events).
// New table only — no changes to existing tables.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  actorId   String?
  type      String   @default("MENTION")
  title     String
  body      String?
  ticketId  String?
  commentId String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model Label {
  id      String   @id @default(cuid())
  name    String   @unique
  color   String
  tickets Ticket[] @relation("TicketLabels")
}

model Comment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id])
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([ticketId])
}

model ActivityLog {
  id        String         @id @default(cuid())
  ticketId  String
  userId    String
  action    ActivityAction
  fromValue String?
  toValue   String?
  createdAt DateTime       @default(now())
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId, createdAt])
}

model Environment {
  id           String                @id @default(cuid())
  name         String
  projectId    String
  createdById  String
  createdAt    DateTime              @default(now())
  createdBy    User                  @relation("EnvironmentCreator", fields: [createdById], references: [id])
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variables    EnvironmentVariable[]
  allowedUsers User[]                @relation("EnvironmentAccess")
  writeUsers   User[]                @relation("EnvironmentWriteAccess")

  @@index([projectId])
}

model EnvironmentVariable {
  id            String      @id @default(cuid())
  key           String
  value         String
  environmentId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, key])
  @@index([environmentId])
}

model Expense {
  id        String         @id @default(cuid())
  name      String
  amount    Float
  date      DateTime
  payerId   String
  createdAt DateTime       @default(now())
  payer     User           @relation("ExpensePayer", fields: [payerId], references: [id])
  splits    ExpenseSplit[]

  @@index([payerId])
}

model ExpenseSplit {
  id         String  @id @default(cuid())
  expenseId  String
  userId     String
  amountOwed Float
  isPaid     Boolean @default(false)
  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User    @relation("UserExpenseSplit", fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
}

model Notebook {
  id          String   @id @default(cuid())
  title       String
  projectId   String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  content     String?
  createdBy   User     @relation("NotebookCreator", fields: [createdById], references: [id])
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model realtime_doc_store {
  id  String @id
  doc String
}

enum Role {
  ADMIN
  MEMBER
  MANAGER
}

enum Department {
  DEV
  DESIGN
  MARKETING
  GENERAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityAction {
  CREATED
  MOVED
  ASSIGNED
  UNASSIGNED
  COMMENTED
  EDITED
  COMPLETED
  REOPENED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  LABEL_ADDED
  LABEL_REMOVED
}

// ─────────────────────────────────────────────────────────────────────────────
// Page Tracker (additive — no existing table is altered except
// `Notification.link` and the optional back-relations on Ticket/User/Project).
// ─────────────────────────────────────────────────────────────────────────────

enum PageType {
  PAGE
  MODULE
}

enum Workstream {
  DESIGN
  DEVELOPMENT
  TESTING
}

// "Approved" is not a resting state: an approved submission closes the item as
// DONE (the approval itself is kept forever in WorkItemReview).
enum WorkItemStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  READY_FOR_REVIEW
  CHANGES_REQUESTED
  DONE
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum TestResult {
  NOT_RUN
  PASS
  FAIL
  BLOCKED
}

enum BugSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BugStatus {
  OPEN
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  READY_FOR_RETEST
  RETEST_FAILED
  VERIFIED
  CLOSED
  WONT_FIX
  DUPLICATE
}

model TrackerPage {
  id                   String         @id @default(cuid())
  projectId            String
  name                 String
  description          String?
  type                 PageType       @default(PAGE)
  priority             Priority       @default(MEDIUM)
  ownerId              String?
  targetDate           DateTime?
  links                Json?
  designRequired       Boolean        @default(true)
  developmentRequired  Boolean        @default(true)
  testingRequired      Boolean        @default(true)
  requireFinalApproval Boolean        @default(false)
  membersCanCreate     Boolean        @default(false)
  releasedAt           DateTime?
  releasedById         String?
  createdById          String
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  archivedAt           DateTime?
  project              Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner                User?          @relation("PageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy            User           @relation("PageCreator", fields: [createdById], references: [id])
  workItems            WorkItem[]
  bugs                 TrackerBug[]
  audits               TrackerAudit[]

  @@index([projectId, archivedAt])
}

model WorkItem {
  id                  String               @id @default(cuid())
  pageId              String
  workstream          Workstream
  title               String
  description         String?
  acceptanceCriteria  String?
  notes               String?
  status              WorkItemStatus       @default(NOT_STARTED)
  priority            Priority             @default(MEDIUM)
  assigneeId          String
  reviewerId          String?
  requiresReview      Boolean              @default(true)
  dueDate             DateTime?
  isRequired          Boolean              @default(true)
  exclusionReason     String?
  blockedReason       String?
  cancelledReason     String?
  links               Json?
  evidence            Json?
  ownerAcknowledged   Boolean              @default(true)
  order               Int                  @default(0)
  currentSubmissionId String?
  ticketId            String?              @unique
  version             Int                  @default(1)
  createdById         String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  completedAt         DateTime?
  archivedAt          DateTime?
  page                TrackerPage          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  assignee            User                 @relation("WorkItemAssignee", fields: [assigneeId], references: [id])
  reviewer            User?                @relation("WorkItemReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("WorkItemCreator", fields: [createdById], references: [id])
  ticket              Ticket?              @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  submissions         WorkItemSubmission[]
  reviews             WorkItemReview[]
  comments            WorkItemComment[]
  testCases           TestCase[]
  audits              TrackerAudit[]
  testBugs            TrackerBug[]         @relation("BugTestItem")
  devBugs             TrackerBug[]         @relation("BugDevItem")

  @@index([pageId, workstream, status])
  @@index([assigneeId, status, dueDate])
  @@index([reviewerId, status])
}

// Immutable snapshot taken at submit time. Only `status` is ever changed
// afterwards (PENDING → APPROVED / CHANGES_REQUESTED) by the review action.
model WorkItemSubmission {
  id               String           @id @default(cuid())
  workItemId       String
  submissionNumber Int
  submittedById    String
  summary          String
  evidence         Json
  testResults      Json?
  status           SubmissionStatus @default(PENDING)
  submittedAt      DateTime         @default(now())
  workItem         WorkItem         @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  submittedBy      User             @relation("SubmissionAuthor", fields: [submittedById], references: [id])
  review           WorkItemReview?

  @@unique([workItemId, submissionNumber])
  @@index([workItemId])
}

model WorkItemReview {
  id              String             @id @default(cuid())
  workItemId      String
  submissionId    String             @unique
  reviewerId      String
  decision        ReviewDecision
  comment         String?
  exceptionReason String?
  reviewedAt      DateTime           @default(now())
  workItem        WorkItem           @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  submission      WorkItemSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer        User               @relation("ReviewAuthor", fields: [reviewerId], references: [id])

  @@index([workItemId])
  @@index([reviewerId, reviewedAt])
}

// Append-only: there is intentionally no edit/delete action.
model WorkItemComment {
  id         String   @id @default(cuid())
  workItemId String
  authorId   String
  body       String
  createdAt  DateTime @default(now())
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  author     User     @relation("WorkItemCommentAuthor", fields: [authorId], references: [id])

  @@index([workItemId, createdAt])
}

model TestCase {
  id            String       @id @default(cuid())
  workItemId    String
  title         String
  preconditions String?
  steps         String?
  expected      String?
  actual        String?
  result        TestResult   @default(NOT_RUN)
  isMandatory   Boolean      @default(true)
  environment   String?
  buildVersion  String?
  evidenceUrl   String?
  testedById    String?
  testedAt      DateTime?
  order         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  workItem      WorkItem     @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  bugs          TrackerBug[]

  @@index([workItemId])
}

model TrackerBug {
  id               String      @id @default(cuid())
  pageId           String
  testWorkItemId   String?
  testCaseId       String?
  devWorkItemId    String?
  title            String
  description      String?
  stepsToReproduce String?
  expectedResult   String?
  actualResult     String?
  severity         BugSeverity @default(MEDIUM)
  priority         Priority    @default(MEDIUM)
  status           BugStatus   @default(OPEN)
  assigneeId       String?
  reporterId       String
  environment      String?
  buildVersion     String?
  evidenceUrl      String?
  releaseBlocking  Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  verifiedAt       DateTime?
  page             TrackerPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  testWorkItem     WorkItem?   @relation("BugTestItem", fields: [testWorkItemId], references: [id], onDelete: SetNull)
  devWorkItem      WorkItem?   @relation("BugDevItem", fields: [devWorkItemId], references: [id], onDelete: SetNull)
  testCase         TestCase?   @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  assignee         User?       @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter         User        @relation("BugReporter", fields: [reporterId], references: [id])

  @@index([pageId, status, severity])
  @@index([assigneeId, status])
}

// Immutable audit trail. No update/delete action exists for this table.
model TrackerAudit {
  id         String       @id @default(cuid())
  pageId     String?
  workItemId String?
  bugId      String?
  actorId    String
  action     String
  summary    String?
  before     Json?
  after      Json?
  reason     String?
  isOverride Boolean      @default(false)
  createdAt  DateTime     @default(now())
  page       TrackerPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  workItem   WorkItem?    @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  actor      User         @relation("TrackerAuditActor", fields: [actorId], references: [id])

  @@index([pageId, createdAt])
  @@index([workItemId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Meetings — schedule Google Meet calls (one-time or recurring) from IFlow.
// Fully additive: new tables only (no existing table or column is altered).
// ─────────────────────────────────────────────────────────────────────────────

enum MeetingKind {
  ONE_TIME
  RECURRING
}

enum MeetingStatus {
  ACTIVE
  CANCELLED
}

enum MeetingSync {
  PENDING
  SYNCED
  FAILED
}

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum MonthlyMode {
  DAY_OF_MONTH
  NTH_WEEKDAY
}

enum RecurrenceEnd {
  NEVER
  ON_DATE
  AFTER_COUNT
}

enum ConnectionStatus {
  ACTIVE
  NEEDS_RECONNECT
}

enum ExceptionType {
  CANCELLED
  MODIFIED
}

// The single team Google account/calendar meetings are created on.
// Refresh token is AES-256-GCM encrypted (same scheme as environment secrets).
model GoogleConnection {
  id             String           @id @default("workspace")
  email          String
  calendarId     String           @default("primary")
  calendarName   String?
  refreshTokenEnc String
  scope          String
  status         ConnectionStatus @default(ACTIVE)
  lastError      String?
  connectedById  String
  connectedAt    DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  connectedBy    User             @relation("GoogleConnector", fields: [connectedById], references: [id])
}

// Email addresses for team members (Google invites need one; User has no email column).
model MemberEmail {
  userId    String   @id
  email     String
  updatedAt DateTime @updatedAt
  user      User     @relation("MemberEmailUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Meeting {
  id               String         @id @default(cuid())
  projectId        String
  title            String
  description      String?
  kind             MeetingKind    @default(ONE_TIME)
  status           MeetingStatus  @default(ACTIVE)

  // When — wall-clock time in `timezone` (what the organizer typed) + derived UTC for ordering.
  startLocal       String         // "YYYY-MM-DDTHH:mm"
  timezone         String         // IANA, e.g. "Asia/Kolkata"
  durationMin      Int
  startUtc         DateTime

  // Recurrence (RECURRING only). `rrule` is the exact string sent to Google.
  freq             RecurrenceFreq?
  interval         Int            @default(1)
  byWeekday        String[]
  monthlyMode      MonthlyMode?
  endType          RecurrenceEnd  @default(NEVER)
  untilDate        String?        // "YYYY-MM-DD" in `timezone`
  occurrenceCount  Int?
  rrule            String?

  // Options
  addMeet          Boolean        @default(true)
  sendInvites      Boolean        @default(true)
  guestsCanModify  Boolean        @default(false)
  guestsCanInvite  Boolean        @default(false)
  guestsCanSeeOthers Boolean      @default(true)
  reminderMinutes  Int?

  // Google sync state
  googleEventId    String?
  // Calendar the event was created on — stays fixed even if the team calendar is switched later.
  calendarId       String?
  meetUrl          String?
  htmlLink         String?
  syncStatus       MeetingSync    @default(PENDING)
  lastError        String?
  lastSyncedAt     DateTime?

  createdById      String
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User           @relation("MeetingCreator", fields: [createdById], references: [id])
  attendees        MeetingAttendee[]
  exceptions       MeetingException[]

  @@index([projectId, status, startUtc])
  @@index([googleEventId])
}

model MeetingAttendee {
  id          String   @id @default(cuid())
  meetingId   String
  userId      String?
  email       String
  displayName String?
  optional    Boolean  @default(false)
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User?    @relation("MeetingAttendeeUser", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([meetingId, email])
  @@index([userId])
}

// One changed/cancelled occurrence of a recurring meeting.
model MeetingException {
  id                String        @id @default(cuid())
  meetingId         String
  originalStartLocal String       // the occurrence being changed, "YYYY-MM-DDTHH:mm" in the meeting timezone
  type              ExceptionType
  newStartLocal     String?
  newDurationMin    Int?
  googleInstanceId  String?
  createdAt         DateTime      @default(now())
  meeting           Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, originalStartLocal])
}
